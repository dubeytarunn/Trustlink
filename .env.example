# ==============================================================================
# TrustLink Environment Configuration Template (.env.example)
# Copy this file to .env and configure values before starting the application:
# cp .env.example .env
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development
DEMO_MODE=true

# Database Path
DATABASE_PATH=./data/trustlink.db

# Cryptography & Key Encryption
# Must be a 32-byte hex string (exactly 64 hex characters) for AES-256-GCM encryption of university private keys.
# Generate a new random secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KEY_ENCRYPTION_SECRET=replace_with_64_character_hex_encryption_key_32_random_bytes_00000

# Authentication & Sessions (JWT)
# Secrets used for signing JSON Web Tokens for student, employer, and university sessions.
# Generate secure random strings for production environments.
JWT_ACCESS_SECRET=replace_with_a_secure_random_jwt_access_secret_minimum_16_chars
JWT_REFRESH_SECRET=replace_with_a_secure_random_jwt_refresh_secret_minimum_16_chars

# Client & Networking
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173
